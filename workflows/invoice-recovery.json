        "jsonBody": "={{ { idempotency_key: 'recovery-executed:' + $('Fetch immutable plan').first().json.id, correlation_id: $('Normalize recovery request').first().json.correlation_id, entity_type: 'invoice', entity_id: $('Fetch immutable plan').first().json.parameters.invoice_id, event_type: 'recovery.executed', occurred_at: $now.toISO(), source: { system: 'n8n', workflow_id: 'invoice-recovery', execution_id: $execution.id, node_name: 'Emit recovery.executed' }, payload: { plan_id: $('Fetch immutable plan').first().json.id } } }}",
        "options": {
          "timeout": 5000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Emit recovery.executed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        -100
