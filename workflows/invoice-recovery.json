        "url": "={{'http://api:8000' + '/api/v1/recovery-plans/' + $('Fetch immutable plan').first().json.id + '/verify'}}",
        "options": {
          "timeout": 10000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Verify authoritative outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "FlowProof API service account",
          "id": "flowproof-api-service-account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: $('Verify authoritative outcome').first().json.status, plan_id: $('Fetch immutable plan').first().json.id } }}",
        "options": {}
      },
      "name": "Return recovery result",
      "type": "n8n-nodes-base.respondToWebhook",
