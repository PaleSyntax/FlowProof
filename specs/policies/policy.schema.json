{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowproof.local/schemas/policy.schema.json",
  "title": "FlowProof Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "entity_type",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "impact": {
      "type": "object"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "guardrails"],
      "properties": {
        "action_type": {"const": "register_missing_invoice"},
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_id",
            "environment",
            "sandbox_only",
            "allowed_currencies",
            "maximum_amount_minor",
            "amount_scale",
            "maximum_semantic_write_attempts",
            "approval_ttl_seconds",
            "reconciliation_method"
          ],
          "properties": {
            "provider_id": {"type": "string", "minLength": 1},
            "environment": {"enum": ["sandbox", "partner_test"]},
            "sandbox_only": {"const": true},
            "allowed_currencies": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z]{3}$"}
            },
            "maximum_amount_minor": {"type": "integer", "minimum": 1},
            "amount_scale": {"type": "integer", "minimum": 0, "maximum": 6},
            "maximum_semantic_write_attempts": {"const": 1},
            "approval_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "reconciliation_method": {"const": "authoritative_invoice_reread"}
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "exactly_once",
              "eventually",
              "ordering",
              "value_matches",
              "external_assertion"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "recovery_action": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
